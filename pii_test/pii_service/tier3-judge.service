# systemd unit for the Tier 3 LLM judge (vLLM serving Qwen3-8B-AWQ), which
# the PII API calls for the columns Tier 1 leaves undecided. Install (needs sudo):
#   sudo cp pii_test/pii_service/tier3-judge.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now tier3-judge
#
# Before the first start, stop any copy launched by hand -- two engines on
# port 8000 cannot both fit on the T4:
#   curl -s 127.0.0.1:8000/v1/models     # answers => one is already up
#
# --gpu-memory-utilization 0.65 (~10 GB of the 15 GB T4) instead of the 0.80
# used by hand: the service's scan models (~2-3 GB at peak) share the card,
# and a CUDA OOM inside the vLLM engine loop kills the whole server. The AWQ
# weights are ~5.7 GB and the KV cache for one 4096-token request ~0.6 GB,
# so 0.65 still leaves room; the judge only ever gets one request at a time.
[Unit]
Description=Tier 3 PII judge (vLLM, Qwen3-8B-AWQ) on 127.0.0.1:8000
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/nic-metadata-cleaning
ExecStart=/home/ubuntu/nic-metadata-cleaning/.venv/bin/vllm serve /home/ubuntu/models/qwen3-8b-awq \
    --served-model-name tier3-judge --dtype float16 --quantization awq \
    --max-model-len 4096 --gpu-memory-utilization 0.65 --disable-log-requests \
    --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=10
# Loading weights + CUDA graph capture takes about a minute; allow for a cold cache.
TimeoutStartSec=600
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
